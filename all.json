iews/templates/views-view-fields.html.twig' -->","retrieved":1761888976297},{"title":"undefined (Avant-Guarde Cyprus)","contents":"<!-- THEME DEBUG -->\n<!-- THEME HOOK: 'views_view_fields' -->\n<!-- BEGIN OUTPUT from 'core/modules/views/templates/views-view-fields.html.twig' -->\n<div class=\"views-field views-field-nothing\"><span class=\"field-content\">\n\n<!-- THEME DEBUG -->\n<!-- THEME HOOK: 'views_view_field' -->\n<!-- BEGIN OUTPUT from 'core/modules/views/templates/views-view-field.html.twig' -->\n<div class=\"calendar-block-content\">\n    <div class=\"calendar-block-image\">\n        <img src=\"/sites/default/files/2024-11/group_11.png\" alt=\"Calendar Thumbnail\">\n    </div>\n    <div class=\"calendar-block-text\">Ατζέντα με&nbsp;όλες&nbsp;τις Συναυλίες, Θεατρικές Παραστάσεις, Εκθέσεις Τέχνης και Live Events από&nbsp;όλες&nbsp;τις εκφάνσεις του Πολιτισμού στην Κύπρο</div>\n</div>\n<!-- END OUTPUT from 'core/modules/views/templates/views-view-field.html.twig' -->\n\n</span></div>\n<!-- END OUTPUT from 'core/modules/views/templates/views-view-fields.html.twig' -->","retrieved":1761888976297},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980376},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980377},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980378},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980379},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980380},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980381},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980382},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980383},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980384},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980385},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980387},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980387},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980389},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980396},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980398},{"title":"undefined (Inside Story Greece)","contents":" ","retrieved":1761888980399},{"title":"Γιατί μπαίνει λουκέτο στα κολυμβητήρια; (Inside Story Greece)","contents":" Τους τελευταίους μήνες, τρία από τα τέσσερα δημοτικά κολυμβητήρια της Αθήνας κατέβασαν ρολά. Η αιτία δεν ήταν η έλλειψη χρημάτων ή προσωπικού, αλλά ότι δεν είχαν νόμιμες άδειες λειτουργίας – σε κάποιες περιπτώσεις, εδώ και δεκαετίες. Και το φαινόμενο δεν περιορίζεται στην πρωτεύουσα.","link":"https://insidestory.gr/article/giati-mpainei-loyketo-sta-kolymbitiria","retrieved":1761868800000},{"title":"10 σημεία επικαιρότητας: 24-31 Οκτωβρίου 2025 (Inside Story Greece)","contents":" H μεγαλύτερη καταιγίδα της ιστορίας. Τα πόστερ του Βασίλη Μαρματάκη. Τι είναι το «Gooning»;","link":"https://insidestory.gr/article/10-simeia-epikairotitas-24-31-oktobrioy-2025","retrieved":1761868800000},{"title":"Αώος: ο τελευταίος άγριος ποταμός κινδυνεύει και δεν φταίει μόνο η κλιματική αλλαγή (Inside Story Greece)","contents":" Από το 1987 που η ΔΕΗ κατασκεύασε ένα μεγάλο υδροηλεκτρικό φράγμα στις πηγές του Αώου, η ροή του ποταμού άλλαξε ριζικά. Σήμερα, οι παρατεταμένες ξηρασίες επιτείνουν τις συνέπειες, καθώς οι γύρω κοινότητες βλέπουν τα νερά χρόνο με τον χρόνο να μην επαρκούν.","link":"https://insidestory.gr/article/aoos-o-teleytaios-agrios-potamos-kindyneyei-kai-den-ftaiei-mono-i-klimatiki-allagi","retrieved":1761782400000},{"title":"Γιατί είναι τόσο σημαντικό για τον Πούτιν το Ντονμπάς; (Inside Story Greece)","contents":" Το Κρεμλίνο έχει επανειλημμένα δηλώσει πως όρος για να προχωρήσει σε οποιαδήποτε συμφωνία με στόχο τον τερματισμό του πολέμου, είναι να παραδώσει η Ουκρανία τον έλεγχο ολόκληρης της περιοχής του Ντονμπάς. Γιατί;","link":"https://insidestory.gr/article/giati-einai-toso-simantiko-gia-ton-poytin-ntonmpas","retrieved":1761696000000},{"title":"Το λιγότερο γνωστό 1940: Οι γερμανόφιλες συνωμοσίες εναντίον του Ι. Μεταξά (Inside Story Greece)","contents":" Από τα τέλη του 1938, γερμανόφιλοι κύκλοι στην Ελλάδα επιδίωκαν την ανατροπή του δικτάτορα Ι. Μεταξά, ώστε να θέσουν τη χώρα στο πλευρό του Άξονα. Οι κινήσεις αυτές εντάθηκαν λίγο πριν και αμέσως μετά την κήρυξη του Ελληνοϊταλικού Πολέμου στις 28 Οκτωβρίου 1940.","link":"https://insidestory.gr/article/ligotero-gnosto-1940-oi-germanofiles-synomosies-enantion-toy-i-metaxa","retrieved":1761523200000},{"title":"Ληστεία στο Λούβρο: Πέντε κλειδιά για να την κατανοήσουμε (Inside Story Greece)","contents":" Από άποψη ασφάλειας, υπάρχουν πέντε βασικές ιδέες που μπορούν να μας βοηθήσουν να κατανοήσουμε ποια ήταν τα κενά στο Λούβρο, καθώς και πώς και γιατί οι εγκληματίες στοχεύουν τα μουσεία.","link":"https://insidestory.gr/article/listeia-sto-loybro-pente-kleidia-gia-na-tin-katanoisoyme","retrieved":1761350400000},{"title":"Ρίχτο, Ηλία! 18-25 Οκτωβρίου 2025 (Inside Story Greece)","contents":" ","link":"https://insidestory.gr/article/rihto-ilia-18-25-oktobrioy-2025","retrieved":1761350400000},{"title":"Η ελληνική ναυτιλία στα διασταυρούμενα πυρά της αμερικανο-κινεζικής ναυμαχίας (Inside Story Greece)","contents":" Τα τέλη ελλιμενισμού που επέβαλαν οι δύο υπερδυνάμεις σε πλοία με κινεζικές και αμερικανικές διασυνδέσεις αντίστοιχα έχουν προκαλέσει μεγάλη αναταραχή στον κλάδο – και αναδεικνύουν τον κίνδυνο κατακερματισμού της παγκόσμιας οικονομίας.","link":"https://insidestory.gr/article/i-elliniki-naytilia-sta-diastayroymena-pyra-tis-amerikano-kinezikis-naymahias","retrieved":1761264000000},{"title":"10 σημεία επικαιρότητας: 17-24 Οκτωβρίου 2025 (Inside Story Greece)","contents":" Ο Τραμπ και η Βενεζουέλα. Έχουμε γίνει «οικονομία του καφέ». Τα τελευταία λόγια της Βιρτζίνια Tζουφρέ.","link":"https://insidestory.gr/article/10-simeia-epikairotitas-17-24-oktobrioy-2025","retrieved":1761264000000},{"title":"Άμωμοι εν οδώ! Αλληλούια (Inside Story Greece)","contents":" Η ποινή του θανάτου, η ζωή των μελλοθάνατων στις ελληνικές φυλακές και οι θανατικές εκτελέσεις κατά τον ελληνικό μεσοπόλεμο μέσα από το λογοτεχνικό και δημοσιογραφικό έργο του Πέτρου Πικρού.","link":"https://insidestory.gr/article/amomoi-en-odo-alliloyia","retrieved":1761177600000}]}